  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: current file (aircraft_tutorial)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${env:USERPROFILE}\.conda\envs\aircraft_tutorial\python.exe",
      "env": { "PYTHONPATH": "${workspaceFolder}\src" }
    }
  ]
}
